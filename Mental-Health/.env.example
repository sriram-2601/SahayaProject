# =================================================================
# SahayA Platform Environment Configuration (Secured)
# =================================================================

# 1. AI Chatbot (Groq Cloud LLaMA 3)
# Keep strictly on the BACKEND to prevent client-side key theft (VAPT #18)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Dedicated Backend Server (server/server.js)
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,https://sriram-2601.github.io

# 3. Optional Frontend Backend URL (defaults to http://localhost:4000)
REACT_APP_BACKEND_URL=http://localhost:4000

# 4. Optional SMS Gateway (Twilio)
# If provided, appointment confirmations & reminders are sent via real SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
