# =================================================================
# SahayA Platform Environment Configuration
# =================================================================

# 1. AI Chatbot (Groq Cloud LLaMA 3)
# Get a free key at https://console.groq.com/keys
REACT_APP_GROQ_API_KEY=your_groq_api_key_here

# 2. Dedicated Backend Server (server/server.js)
PORT=4000

# 3. Optional SMS Gateway (Twilio)
# If provided, appointment confirmations & reminders are sent via real SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
