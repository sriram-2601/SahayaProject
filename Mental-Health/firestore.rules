rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: Only authenticated owners can read/write their own profile
    match /Users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // UserInfo collection: Restrict to authenticated users
    match /userinfo/{infoId} {
      allow read, write: if request.auth != null;
    }

    // Tasks collection: Restrict to authenticated users
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // Notifications collection: Restrict to authenticated users
    match /notifications/{notiId} {
      allow read, write: if request.auth != null;
    }

    // Feedback collection: Anyone authenticated can submit; read restricted
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if false;
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
