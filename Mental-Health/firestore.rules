rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Users collection & user-scoped subcollections (tasks, appointments, notifications, profiles)
    // Strict Access Control: Only the authenticated owner can read or write their own documents and subcollections.
    match /Users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. UserInfo collection: Restrict strictly to document owner
    match /userinfo/{infoId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == infoId || 
        (resource != null && resource.data.userId == request.auth.uid) || 
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    // 3. Community Messages: Authenticated users can read and post messages
    match /community_messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.senderId == request.auth.uid;
    }

    // 4. Feedbacks: Authenticated users can submit feedback; direct read is blocked
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // 5. Default Deny Fallback (VAPT Access Control Hardening)
    // Closes wildcard authorization bypass: any unmatched route is rejected by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
